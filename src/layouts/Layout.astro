---
export let title = 'BJourneyGo';
export let description = 'A starter site built with BJourneyGo.';
export let url = '';
export let image = '/social-card.svg';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/bJourneyGO4%20(1).png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Social -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{url ? <meta property="og:url" content={url} /> : null}
		<meta property="og:image" content={image} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="brand" href="/">
					<img src="/bJourneyGO4%20(1).png" alt="BJourneyGo logo" class="brand-logo" loading="eager" fetchpriority="high" />
					<span>BJourneyGo</span>
				</a>
				<button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Abrir menú">
					<svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
					</svg>
				</button>
				<div class="nav-backdrop" id="navBackdrop"></div>
				<nav class="nav" id="mainNav">
					<a href="/">Inicio</a>
					<a href="/comprar">Comprar billetes</a>
					<a href="#features">Características</a>
					<a href="#docs" target="_blank" rel="noopener">Docs</a>
					<a href="/intranet-login">Intranet</a>
				</nav>
				<!-- User dropdown menu -->
				<div class="user-menu" id="userMenu" style="display:none">
					<button class="user-menu-toggle" id="userMenuToggle" aria-label="Menú de usuario">
						<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
						</svg>
					</button>
					<div class="user-dropdown" id="userDropdown">
						<div class="user-dropdown-header">
							<span id="userName">Usuario</span>
						</div>
						<a href="/configuracion" class="user-dropdown-item">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
							</svg>
							Configuración
						</a>
						<button id="logoutBtn" class="user-dropdown-item">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
							</svg>
							Cerrar sesión
						</button>
					</div>
				</div>
				<!-- Login button for non-authenticated users -->
				<div class="user-menu" id="guestMenu" style="display:none">
					<button class="user-menu-toggle" id="guestMenuToggle" aria-label="Cuenta">
						<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
						</svg>
					</button>
					<div class="user-dropdown" id="guestDropdown">
						<a href="/login" class="user-dropdown-item">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
							</svg>
							Iniciar sesión
						</a>
						<a href="/register" class="user-dropdown-item">
							<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
							</svg>
							Registrarse
						</a>
					</div>
				</div>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container">
				<p>© {new Date().getFullYear()} BJourneyGo — Built with Astro</p>
				<p class="muted">Made with ♥ in your editor</p>
			</div>
		</footer>

		<script type="module">
			// Manage user menu and auth state
			const guestMenu = document.getElementById('guestMenu');
			const guestMenuToggle = document.getElementById('guestMenuToggle');
			const guestDropdown = document.getElementById('guestDropdown');
			const userMenu = document.getElementById('userMenu');
			const userName = document.getElementById('userName');
			const userMenuToggle = document.getElementById('userMenuToggle');
			const userDropdown = document.getElementById('userDropdown');
			const logoutBtn = document.getElementById('logoutBtn');

			function updateAuth() {
				const authed = localStorage.getItem('auth') === 'true';
				const user = localStorage.getItem('user') || 'Usuario';
				
				if (authed) {
					// Show user menu, hide guest menu
					if (guestMenu) guestMenu.style.display = 'none';
					if (userMenu) userMenu.style.display = 'block';
					if (userName) userName.textContent = user;
				} else {
					// Show guest menu, hide user menu
					if (guestMenu) guestMenu.style.display = 'block';
					if (userMenu) userMenu.style.display = 'none';
				}
			}

			// Toggle guest dropdown
			guestMenuToggle?.addEventListener('click', (e) => {
				e.stopPropagation();
				guestDropdown?.classList.toggle('open');
			});

			// Toggle user dropdown
			userMenuToggle?.addEventListener('click', (e) => {
				e.stopPropagation();
				userDropdown?.classList.toggle('open');
			});

			// Close dropdown when clicking outside
			document.addEventListener('click', (e) => {
				if (!userMenu?.contains(e.target)) {
					userDropdown?.classList.remove('open');
				}
				if (!guestMenu?.contains(e.target)) {
					guestDropdown?.classList.remove('open');
				}
			});

			// Logout handler
			logoutBtn?.addEventListener('click', () => {
				localStorage.removeItem('auth');
				localStorage.removeItem('user');
				localStorage.removeItem('isAdmin');
				location.replace('/');
			});

			updateAuth();

			// Mobile menu toggle
			const menuToggle = document.getElementById('mobileMenuToggle');
			const nav = document.getElementById('mainNav');
			const navBackdrop = document.getElementById('navBackdrop');

			function openMenu() {
				nav?.classList.add('open');
				navBackdrop?.classList.add('open');
				document.body.style.overflow = 'hidden';
			}

			function closeMenu() {
				nav?.classList.remove('open');
				navBackdrop?.classList.remove('open');
				document.body.style.overflow = '';
			}

			menuToggle?.addEventListener('click', openMenu);
			navBackdrop?.addEventListener('click', closeMenu);

			// Close menu when clicking nav links
			nav?.querySelectorAll('a').forEach(link => {
				link.addEventListener('click', closeMenu);
			});
		</script>





		<script>
			// show/hide intranet link
			const intranetLink = document.getElementById('intranet-link');
			function updateIntranetLink() {
				const isAdmin = localStorage.getItem('isAdmin') === 'true';
				if (!intranetLink) return;
				intranetLink.style.display = isAdmin ? 'inline-block' : 'none';
				if (isAdmin) intranetLink.setAttribute('href', '/intranet');
			}

			updateIntranetLink();
			window.addEventListener('storage', updateIntranetLink);
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<style is:global>
	:root{
		--bg: #fafaf9;
		--card: #ffffff;
		--text: #1e293b;
		--text-muted: #64748b;
		--accent-1: #f97316;
		--accent-2: #ea580c;
		--border: #e2e8f0;
		--shadow: rgba(0,0,0,0.08);
		--shadow-hover: rgba(0,0,0,0.12);
	}
	body{
		background: linear-gradient(135deg, #fef3e2 0%, #fef8ed 100%);
		color: var(--text);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		-webkit-font-smoothing:antialiased;
		-moz-osx-font-smoothing:grayscale;
		line-height:1.6;
		min-height:100vh;
		display:flex;
		flex-direction:column;
	}
	.container{max-width:1100px;margin:0 auto;padding:1rem 1.25rem;}
	@media (max-width:768px){.container{padding:1rem}}
	/* Button tokens */
	.btn{display:inline-flex;align-items:center;justify-content:center;padding:.7rem 1.25rem;border-radius:10px;border:1px solid transparent;font-weight:600;text-decoration:none;cursor:pointer;transition:all .2s ease;font-size:.95rem}
	.btn:hover{transform:translateY(-2px)}
	.btn--primary{background:linear-gradient(135deg,var(--accent-1),var(--accent-2));color:#fff;box-shadow:0 4px 12px rgba(249,115,22,0.25);border:none}
	.btn--primary:hover{box-shadow:0 8px 20px rgba(249,115,22,0.35);transform:translateY(-3px)}
	.btn--ghost{background:var(--card);color:var(--text);border:1px solid var(--border);box-shadow:0 2px 4px var(--shadow)}
	.btn--ghost:hover{border-color:var(--accent-1);background:#fff;box-shadow:0 4px 8px var(--shadow-hover)}
	.btn--small{padding:.5rem .9rem;font-size:.9rem}
	.site-header{border-bottom:1px solid var(--border);backdrop-filter:blur(12px);background:rgba(255,255,255,0.9);box-shadow:0 1px 3px var(--shadow);position:sticky;top:0;z-index:100}
	.site-header .container{display:flex;justify-content:space-between;align-items:center}
	.brand{font-weight:700;color:var(--accent-1);text-decoration:none;font-size:1.125rem;cursor:pointer;transition:all .2s ease;display:inline-flex;align-items:center;gap:.75rem}
	.brand:hover{transform:scale(1.02)}
	.brand-logo{width:72px;height:72px;display:block;object-fit:contain;border-radius:0}
	.brand span{font-size:1.125rem;font-weight:700;color:var(--accent-1);letter-spacing:0.2px}
	@media (max-width:720px){
		.brand-logo{width:44px;height:44px}
		.brand span{display:none}
	}
	.nav{display:flex;gap:.5rem;align-items:center}
	.nav a{color:var(--text-muted);text-decoration:none;cursor:pointer;transition:all .2s ease;font-weight:500;padding:.5rem .75rem;border-radius:8px;display:block}
	.nav a:hover{color:var(--accent-1);background:rgba(249,115,22,0.08)}
	.mobile-menu-toggle{display:none;background:none;border:none;cursor:pointer;padding:.5rem;color:var(--text);z-index:101}
	.mobile-menu-toggle svg{width:28px;height:28px;stroke-width:2}
	.nav-backdrop{display:none}
	/* User menu styles */
	.user-menu{position:relative;display:none}
	.user-menu-toggle{background:none;border:1px solid var(--border);border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s ease;color:var(--text)}
	.user-menu-toggle:hover{background:rgba(249,115,22,0.08);border-color:var(--accent-1)}
	.user-dropdown{position:absolute;top:calc(100% + 8px);right:0;background:var(--card);border:1px solid var(--border);border-radius:12px;box-shadow:0 8px 24px var(--shadow);min-width:200px;opacity:0;visibility:hidden;transform:translateY(-8px);transition:all .2s ease;z-index:1001}
	.user-dropdown.open{opacity:1;visibility:visible;transform:translateY(0)}
	.user-dropdown-header{padding:.85rem 1rem;border-bottom:1px solid var(--border);font-weight:600;color:var(--text);font-size:.95rem}
	.user-dropdown-item{display:flex;align-items:center;gap:.75rem;padding:.85rem 1rem;color:var(--text);text-decoration:none;transition:all .2s ease;border:none;background:none;width:100%;text-align:left;cursor:pointer;font-size:.95rem}
	.user-dropdown-item:hover{background:rgba(249,115,22,0.08);color:var(--accent-1)}
	.user-dropdown-item:last-child{border-radius:0 0 12px 12px}
	.user-dropdown-item svg{flex-shrink:0}
	@media (max-width:768px){
		.mobile-menu-toggle{display:flex;align-items:center;justify-content:center}
		.nav{position:fixed;top:0;left:-100%;width:80%;max-width:340px;height:100vh;background:var(--card);box-shadow:4px 0 20px rgba(0,0,0,0.15);flex-direction:column;align-items:stretch;padding:3rem 0 2rem;gap:0;transition:left .35s cubic-bezier(0.4, 0, 0.2, 1);z-index:1000;overflow-y:auto;border-right:1px solid var(--border)}
		.nav.open{left:0}
		.nav a{width:100%;padding:1.1rem 1.75rem;font-size:1.1rem;border-radius:0;border-bottom:1px solid var(--border);color:var(--text);font-weight:500;text-align:left}
		.nav a:first-child{border-top:1px solid var(--border)}
		.nav a:hover{background:linear-gradient(90deg, rgba(249,115,22,0.08), transparent);color:var(--accent-1)}
		.nav-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:999;backdrop-filter:blur(2px)}
		.nav-backdrop.open{display:block}
	}
	main{flex:1;}
	.site-footer{border-top:1px solid var(--border);padding:1.5rem 0;margin-top:3rem;background:rgba(255,255,255,0.5);color:var(--text-muted)}
	.site-footer p{margin:0}
	.site-footer .muted{opacity:0.8}
	@media (max-width:768px){
		.site-footer{text-align:center;font-size:.9rem}
		.site-footer p{margin:.25rem 0}
	}
</style>
