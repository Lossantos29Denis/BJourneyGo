---
import AuthLayout from '../layouts/AuthLayout.astro';
import '../styles/login.css';
---

<AuthLayout title="Iniciar sesión — BJourneyGo">
  <main class="container">
    <div class="site-header">
      <img src="/bJourneyGO4%20(1).png" alt="BJourneyGo logo" class="site-logo" />
      <div class="site-title">BJourneyGo</div>
    </div>

    <section class="login-card">
      <div class="login-header">
        <h1>Inicia sesión</h1>
        <p class="lead">Ingresa para continuar al sitio.</p>
      </div>

      <form id="loginForm" class="login-form" novalidate>
        <label id="label-email" for="email">Correo electrónico (o usuario admin)</label>
        <input id="email" name="email" type="text" placeholder="tu@correo.com o usuario admin" class="form-input" autocomplete="email" aria-label="Correo o usuario" aria-required="true" required minlength="3" />

        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" placeholder="contraseña" class="form-input" autocomplete="current-password" aria-label="Contraseña" aria-required="true" required minlength="4" />

        <div class="btn-row">
          <button type="submit" class="btn btn--primary" style="width:100%">Iniciar sesión</button>
        </div>
      </form>

      <div class="register-link">
        <p>¿No tienes una cuenta? <a href="/register" class="link-register">Regístrate aquí</a></p>
      </div>

      <p class="notice">Este es un inicio de sesión local de ejemplo que guarda una bandera en el navegador. Implementa autenticación real para producción.</p>
    </section>
  </main>

  <script type="module" src="/src/scripts/login.js"></script>
</AuthLayout>
