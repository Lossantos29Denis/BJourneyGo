---
import Layout from '../layouts/Layout.astro';
---

<script is:inline>
  // Verificar autenticación de intranet antes de renderizar
  if (typeof window !== 'undefined') {
    const intranetAuth = localStorage.getItem('intranetAuth');
    if (intranetAuth !== 'true') {
      window.location.replace('/intranet-login');
    }
  }
</script>

<Layout title="Estadísticas — BJourneyGo">
  <div class="page-wrapper">
    <main class="container page-content">
      <section class="stats-hero">
        <div class="hero-header">
          <a href="/intranet" class="back-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Volver a Intranet
          </a>
          <h1>Estadísticas y Métricas</h1>
          <p class="lead">Panel de control con métricas de ventas, ocupación y rendimiento.</p>
        </div>
      </section>

      <!-- Resumen de KPIs principales -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-icon" style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(34, 197, 94, 0.05)); color: #22c55e;">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="28" height="28">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="kpi-content">
            <p class="kpi-label">Ingresos del mes</p>
            <p class="kpi-value" id="monthlyRevenue">€0</p>
            <p class="kpi-change positive">+12.5% vs mes anterior</p>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon" style="background: linear-gradient(135deg, rgba(249, 115, 22, 0.1), rgba(249, 115, 22, 0.05)); color: var(--accent-1);">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="28" height="28">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
          </div>
          <div class="kpi-content">
            <p class="kpi-label">Billetes vendidos</p>
            <p class="kpi-value" id="ticketsSold">0</p>
            <p class="kpi-change positive">+8.3% vs mes anterior</p>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(59, 130, 246, 0.05)); color: #3b82f6;">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="28" height="28">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div class="kpi-content">
            <p class="kpi-label">Clientes activos</p>
            <p class="kpi-value" id="activeCustomers">0</p>
            <p class="kpi-change positive">+5.7% vs mes anterior</p>
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-icon" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.1), rgba(168, 85, 247, 0.05)); color: #a855f7;">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="28" height="28">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <div class="kpi-content">
            <p class="kpi-label">Ocupación media</p>
            <p class="kpi-value" id="averageOccupancy">0%</p>
            <p class="kpi-change neutral">+2.1% vs mes anterior</p>
          </div>
        </div>
      </div>

      <!-- Gráficas principales -->
      <div class="charts-grid">
        <section class="chart-card large">
          <div class="chart-header">
            <h3>Ventas mensuales (último año)</h3>
            <div class="chart-filters">
              <button class="filter-btn active" data-period="year">Año</button>
              <button class="filter-btn" data-period="quarter">Trimestre</button>
              <button class="filter-btn" data-period="month">Mes</button>
            </div>
          </div>
          <div class="chart-container">
            <canvas id="salesChart"></canvas>
          </div>
        </section>

        <section class="chart-card">
          <div class="chart-header">
            <h3>Ocupación por ruta</h3>
          </div>
          <div class="chart-container">
            <canvas id="occupancyChart"></canvas>
          </div>
        </section>

        <section class="chart-card">
          <div class="chart-header">
            <h3>Distribución de ventas</h3>
          </div>
          <div class="chart-container">
            <canvas id="distributionChart"></canvas>
          </div>
        </section>
      </div>

      <!-- Tabla de rutas más populares -->
      <section class="data-table-section">
        <div class="section-header">
          <h3>Rutas más populares</h3>
          <button class="btn btn--ghost btn--small">Exportar datos</button>
        </div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Ruta</th>
                <th>Origen</th>
                <th>Destino</th>
                <th>Ventas</th>
                <th>Ingresos</th>
                <th>Ocupación</th>
                <th>Tendencia</th>
              </tr>
            </thead>
            <tbody id="routesTableBody">
              <tr>
                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                  Cargando datos...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Análisis adicional -->
      <div class="analysis-grid">
        <section class="analysis-card">
          <h3>Horarios más demandados</h3>
          <div class="time-slots">
            <div class="time-slot">
              <div class="time-label">06:00 - 09:00</div>
              <div class="time-bar" style="width: 85%">
                <span class="time-value">85%</span>
              </div>
            </div>
            <div class="time-slot">
              <div class="time-label">09:00 - 12:00</div>
              <div class="time-bar" style="width: 62%">
                <span class="time-value">62%</span>
              </div>
            </div>
            <div class="time-slot">
              <div class="time-label">12:00 - 15:00</div>
              <div class="time-bar" style="width: 48%">
                <span class="time-value">48%</span>
              </div>
            </div>
            <div class="time-slot">
              <div class="time-label">15:00 - 18:00</div>
              <div class="time-bar" style="width: 71%">
                <span class="time-value">71%</span>
              </div>
            </div>
            <div class="time-slot">
              <div class="time-label">18:00 - 21:00</div>
              <div class="time-bar" style="width: 92%">
                <span class="time-value">92%</span>
              </div>
            </div>
          </div>
        </section>

        <section class="analysis-card">
          <h3>Métricas de rendimiento</h3>
          <div class="metrics-list">
            <div class="metric-item">
              <span class="metric-label">Tiempo medio de compra</span>
              <span class="metric-value">2.4 min</span>
            </div>
            <div class="metric-item">
              <span class="metric-label">Tasa de conversión</span>
              <span class="metric-value">68.5%</span>
            </div>
            <div class="metric-item">
              <span class="metric-label">Ticket medio</span>
              <span class="metric-value">€24.50</span>
            </div>
            <div class="metric-item">
              <span class="metric-label">Devoluciones</span>
              <span class="metric-value">3.2%</span>
            </div>
            <div class="metric-item">
              <span class="metric-label">Reservas anticipadas</span>
              <span class="metric-value">45.8%</span>
            </div>
          </div>
        </section>
      </div>

    </main>
  </div>

  <style>
    .page-wrapper{min-height:calc(100vh - 160px);display:flex;flex-direction:column}
    .page-content{flex:1;padding-bottom:3rem}

    .stats-hero{margin:2rem 0;text-align:center}
    .hero-header{max-width:800px;margin:0 auto}
    .back-link{display:inline-flex;align-items:center;gap:.5rem;color:var(--text-muted);font-size:.95rem;margin-bottom:1rem;transition:color .2s;text-decoration:none}
    .back-link:hover{color:var(--accent-1)}
    .stats-hero h1{margin:.5rem 0;color:var(--accent-1);font-size:2rem;font-weight:700;letter-spacing:-0.5px}
    .lead{color:var(--text-muted);margin:.5rem auto 2rem auto;font-size:1.05rem}

    /* KPI Cards */
    .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;margin-bottom:2rem}
    .kpi-card{background:var(--card);padding:1.5rem;border-radius:14px;border:1px solid var(--border);box-shadow:0 2px 8px var(--shadow);display:flex;gap:1rem;align-items:center;transition:all .25s ease}
    .kpi-card:hover{transform:translateY(-2px);box-shadow:0 6px 16px var(--shadow-hover)}
    
    .kpi-icon{width:56px;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .kpi-content{flex:1;min-width:0}
    .kpi-label{margin:0;color:var(--text-muted);font-size:.85rem;font-weight:500;text-transform:uppercase;letter-spacing:.5px}
    .kpi-value{margin:.25rem 0;color:var(--text);font-size:1.75rem;font-weight:700;line-height:1}
    .kpi-change{margin:.25rem 0 0 0;font-size:.85rem}
    .kpi-change.positive{color:#22c55e}
    .kpi-change.negative{color:#ef4444}
    .kpi-change.neutral{color:var(--text-muted)}

    /* Charts */
    .charts-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;margin-bottom:2rem}
    .chart-card{background:var(--card);padding:1.5rem;border-radius:14px;border:1px solid var(--border);box-shadow:0 2px 8px var(--shadow)}
    .chart-card.large{grid-column:1/-1}
    
    .chart-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:.75rem}
    .chart-header h3{margin:0;color:var(--text);font-size:1.15rem;font-weight:600}
    
    .chart-filters{display:flex;gap:.5rem}
    .filter-btn{padding:.4rem .85rem;background:transparent;border:1px solid var(--border);border-radius:8px;color:var(--text-muted);font-size:.85rem;cursor:pointer;transition:all .2s}
    .filter-btn:hover{background:var(--bg-muted);border-color:var(--accent-1);color:var(--text)}
    .filter-btn.active{background:var(--accent-1);border-color:var(--accent-1);color:white}
    
    .chart-container{position:relative;height:300px;width:100%}
    .chart-card.large .chart-container{height:350px}

    /* Data Table */
    .data-table-section{background:var(--card);padding:1.5rem;border-radius:14px;border:1px solid var(--border);box-shadow:0 2px 8px var(--shadow);margin-bottom:2rem}
    .section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;gap:.75rem}
    .section-header h3{margin:0;color:var(--text);font-size:1.15rem;font-weight:600}
    
    .table-responsive{overflow-x:auto}
    .data-table{width:100%;border-collapse:collapse}
    .data-table th,.data-table td{padding:.85rem 1rem;text-align:left;border-bottom:1px solid var(--border)}
    .data-table th{color:var(--text-muted);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.5px;background:var(--bg-muted)}
    .data-table td{color:var(--text);font-size:.95rem}
    .data-table tr:hover{background:var(--bg-muted)}
    .data-table .trend-up{color:#22c55e}
    .data-table .trend-down{color:#ef4444}

    /* Analysis Cards */
    .analysis-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.25rem}
    .analysis-card{background:var(--card);padding:1.5rem;border-radius:14px;border:1px solid var(--border);box-shadow:0 2px 8px var(--shadow)}
    .analysis-card h3{margin:0 0 1.25rem 0;color:var(--text);font-size:1.15rem;font-weight:600}

    /* Time Slots */
    .time-slots{display:flex;flex-direction:column;gap:.85rem}
    .time-slot{display:flex;align-items:center;gap:.75rem}
    .time-label{min-width:110px;color:var(--text-muted);font-size:.9rem;font-weight:500}
    .time-bar{position:relative;height:32px;background:linear-gradient(90deg,var(--accent-1),rgba(249,115,22,0.6));border-radius:6px;display:flex;align-items:center;padding:0 .75rem;transition:width .3s ease}
    .time-value{color:white;font-size:.85rem;font-weight:600}

    /* Metrics List */
    .metrics-list{display:flex;flex-direction:column;gap:1rem}
    .metric-item{display:flex;justify-content:space-between;align-items:center;padding:.75rem 0;border-bottom:1px solid var(--border)}
    .metric-item:last-child{border-bottom:none}
    .metric-label{color:var(--text-muted);font-size:.95rem}
    .metric-value{color:var(--text);font-size:1.1rem;font-weight:600}

    @media (max-width:1100px){
      .charts-grid{grid-template-columns:1fr}
      .chart-card.large{grid-column:auto}
    }

    @media (max-width:900px){
      .kpi-grid{grid-template-columns:repeat(2,1fr)}
      .analysis-grid{grid-template-columns:1fr}
    }

    @media (max-width:620px){
      .stats-hero{margin:1.5rem 0}
      .stats-hero h1{font-size:1.5rem}
      .lead{font-size:1rem}
      .kpi-grid{grid-template-columns:1fr}
      .kpi-card{padding:1.25rem}
      .kpi-value{font-size:1.5rem}
      .chart-card{padding:1.25rem}
      .chart-container{height:250px}
      .chart-card.large .chart-container{height:280px}
      .data-table-section{padding:1rem}
      .data-table th,.data-table td{padding:.65rem .75rem;font-size:.85rem}
      .time-label{min-width:90px;font-size:.85rem}
      .time-bar{height:28px}
    }

    @media (max-width:480px){
      .kpi-card{flex-direction:column;text-align:center;padding:1rem}
      .kpi-icon{margin-bottom:.5rem}
      .filter-btn{padding:.35rem .7rem;font-size:.8rem}
      .chart-header{flex-direction:column;align-items:flex-start}
    }
  </style>

  <script type="module">
    // Protect statistics page: verify intranet authentication
    const intranetAuth = localStorage.getItem('intranetAuth');
    if (intranetAuth !== 'true') {
      location.replace('/intranet-login');
    }

    const role = localStorage.getItem('intranetRole') || 'admin';
    const agencyId = localStorage.getItem('agencyId') || '';
    const agencyName = localStorage.getItem('agencyName') || '';

    // Update title for agency users
    if (role === 'agency') {
      document.querySelector('.stats-hero h1').textContent = 'Estadísticas de ' + agencyName;
      document.querySelector('.lead').textContent = 'Panel de control con métricas de tus ventas, ocupación y rendimiento.';
    }

    // Simulated data generation
    function generateMockData() {
      // Filter data by agency if not admin
      const dataMultiplier = role === 'agency' ? 0.3 : 1; // Agency sees 30% of total data
      
      // KPIs
      document.getElementById('monthlyRevenue').textContent = '€' + Math.round(45287 * dataMultiplier).toLocaleString('es-ES');
      document.getElementById('ticketsSold').textContent = Math.round(1847 * dataMultiplier).toLocaleString('es-ES');
      document.getElementById('activeCustomers').textContent = Math.round(892 * dataMultiplier).toLocaleString('es-ES');
      document.getElementById('averageOccupancy').textContent = '76.8%';

      // Popular routes table - filter by agency
      let routes = [
        { name: 'MAD-BCN-001', origin: 'Madrid', dest: 'Barcelona', sales: 342, revenue: '€8,550', occupancy: '92%', trend: 'up' },
        { name: 'BCN-VAL-002', origin: 'Barcelona', dest: 'Valencia', sales: 298, revenue: '€6,700', occupancy: '85%', trend: 'up' },
        { name: 'MAD-SEV-003', origin: 'Madrid', dest: 'Sevilla', sales: 276, revenue: '€7,180', occupancy: '81%', trend: 'neutral' },
        { name: 'VAL-ALC-004', origin: 'Valencia', dest: 'Alicante', sales: 245, revenue: '€4,410', occupancy: '78%', trend: 'up' },
        { name: 'BCN-MAD-005', origin: 'Barcelona', dest: 'Madrid', sales: 231, revenue: '€5,775', occupancy: '74%', trend: 'down' },
        { name: 'SEV-GRX-006', origin: 'Sevilla', dest: 'Granada', sales: 189, revenue: '€3,780', occupancy: '68%', trend: 'neutral' },
        { name: 'MAD-VAL-007', origin: 'Madrid', dest: 'Valencia', sales: 176, revenue: '€4,048', occupancy: '65%', trend: 'up' },
        { name: 'BCN-ZAR-008', origin: 'Barcelona', dest: 'Zaragoza', sales: 154, revenue: '€3,234', occupancy: '61%', trend: 'up' }
      ];

      // Filter routes if agency role
      const filteredRoutes = role === 'agency' 
        ? routes.filter((_, index) => index < 3) // Agency sees only first 3 routes
        : routes;

      const tbody = document.getElementById('routesTableBody');
      tbody.innerHTML = filteredRoutes.map(route => `
        <tr>
          <td><strong>${route.name}</strong></td>
          <td>${route.origin}</td>
          <td>${route.dest}</td>
          <td>${route.sales}</td>
          <td>${route.revenue}</td>
          <td>${route.occupancy}</td>
          <td class="trend-${route.trend}">
            ${route.trend === 'up' ? '↑' : route.trend === 'down' ? '↓' : '→'}
          </td>
        </tr>
      `).join('');
    }

    // Initialize mock data
    generateMockData();

    // Chart placeholders (would use Chart.js or similar in production)
    function initCharts() {
      const canvases = document.querySelectorAll('canvas');
      canvases.forEach(canvas => {
        const ctx = canvas.getContext('2d');
        const width = canvas.width = canvas.offsetWidth;
        const height = canvas.height = canvas.offsetHeight;
        
        // Simple placeholder visualization
        ctx.fillStyle = 'rgba(249, 115, 22, 0.1)';
        ctx.fillRect(0, 0, width, height);
        
        ctx.strokeStyle = 'var(--accent-1)';
        ctx.lineWidth = 3;
        ctx.beginPath();
        
        // Generate random line chart
        for (let i = 0; i <= 12; i++) {
          const x = (width / 12) * i;
          const y = height - (Math.random() * height * 0.6 + height * 0.2);
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // Add text
        ctx.fillStyle = 'var(--text-muted)';
        ctx.font = '14px system-ui';
        ctx.textAlign = 'center';
        ctx.fillText('Gráfico de ejemplo (integrar Chart.js para datos reales)', width / 2, height / 2);
      });
    }

    // Wait for fonts and layout to load
    setTimeout(initCharts, 100);
    window.addEventListener('resize', initCharts);

    // Filter buttons functionality
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        // In production, would reload chart data based on selected period
      });
    });
  </script>
</Layout>
