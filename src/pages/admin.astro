<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel Admin — BJourneyGo</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    h1 {
      color: #0066cc;
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    p {
      color: #666;
      margin-bottom: 1.5rem;
    }

    section {
      margin-top: 1.25rem;
      background: #fff;
      padding: 1.5rem;
      border-radius: 14px;
      border: 1px solid #e0e0e0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    section h3 {
      color: #333;
      margin-top: 0;
    }

    #sessionInfo {
      color: #666;
      margin-bottom: 1rem;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1rem;
      transition: all 0.3s ease;
    }

    .btn--ghost {
      background: transparent;
      border: 1px solid #0066cc;
      color: #0066cc;
    }

    .btn--ghost:hover {
      background: #0066cc;
      color: #fff;
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 1rem;
      }
      h1 {
        font-size: 1.5rem;
      }
      section {
        padding: 1.25rem;
      }
    }

    @media (max-width: 480px) {
      h1 {
        font-size: 1.35rem;
      }
      section {
        padding: 1rem;
      }
      p {
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>
  <main class="container" style="padding-top:2rem;padding-bottom:3rem">
    <div id="admin-root" style="max-width:900px;margin:0 auto;">
      <h1 style="color:var(--accent-1);font-size:2rem;margin-bottom:.5rem">Panel de administración</h1>
      <p style="color:var(--text-muted);margin-bottom:1.5rem">Área restringida. Solo accesible para administradores.</p>

      <section style="margin-top:1.25rem;background:var(--card);padding:1.5rem;border-radius:14px;border:1px solid var(--border);box-shadow:0 2px 8px var(--shadow)">
        <h3 style="color:var(--text);margin-top:0">Información de sesión</h3>
        <p id="sessionInfo" style="color:var(--text-muted);margin-bottom:1rem">Cargando...</p>
        <button id="logoutBtn" class="btn btn--ghost">Cerrar sesión</button>
      </section>
    </div>
  </main>

  <style>
    @media (max-width:768px){
      #admin-root{padding:0 1rem}
    }

    @media (max-width:620px){
      h1{font-size:1.5rem!important}
      section{padding:1.25rem!important}
    }

    @media (max-width:480px){
      h1{font-size:1.35rem!important}
      section{padding:1rem!important}
      p{font-size:0.9rem!important}
    }
  </style>

  <script type="module">
    // Protect admin page client-side: check isAdmin flag
    const isAdmin = localStorage.getItem('isAdmin') === 'true';
    if (!isAdmin) {
      // redirect to login
      location.replace('/login');
    } else {
      const user = localStorage.getItem('user') || 'admin';
      document.getElementById('sessionInfo').textContent = `Conectado como: ${user} (administrador)`;
    }

    document.getElementById('logoutBtn')?.addEventListener('click', () => {
      localStorage.removeItem('auth');
      localStorage.removeItem('isAdmin');
      localStorage.removeItem('user');
      location.replace('/');
    });
  </script>
</body>
</html>
