{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "sourceMap": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/lib/**/*.ts",
    "src/routes/express/**/*.ts",
    "src/types/**/*.ts"
  ]
}
