# Mail configuration
# Prefer Resend: set your Resend API key below
RESEND_API_KEY=re_...
RESEND_FROM=no-reply@bjourneygo.me
RESEND_FROM_NAME=BJourneyGo

# SMTP configuration (fallback local provider)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=your-smtp-user
#SMTP_PASS=your-smtp-password
#SMTP_FROM=no-reply@bjourneygo.me
#SMTP_FROM_NAME="BJourneyGo"

# Optional: recipient for test email (defaults to RESEND_FROM or SMTP_USER)
TEST_TO=your-other-email@example.com

# Optional: disable all outgoing email (recommended if on limited quota)
#MAIL_DISABLED=true

# Optional: resend verification rate limits
#VERIFY_RESEND_MIN_SECONDS=60
#VERIFY_RESEND_MAX_PER_HOUR=3

# Optional: email branding
#EMAIL_BRAND_NAME=BJourneyGo
#EMAIL_BRAND_COLOR=#F5C542
#EMAIL_LOGO_URL=https://www.bjourneygo.me/logo.svg
#SUPPORT_EMAIL=support@bjourneygo.me

# Stripe (Checkout)
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_PUBLISHABLE_KEY=pk_test_...
#STRIPE_SUCCESS_URL=https://www.bjourneygo.me/pago-exitoso
#STRIPE_CANCEL_URL=https://www.bjourneygo.me/pago-cancelado
#STRIPE_CURRENCY=EUR

# Default commission percent for agencies
#COMMISSION_DEFAULT_PERCENT=10

# Optional: front-end URL for verification links (recommended)
WEB_URL=http://localhost:4321

# Database and server
DATABASE_URL="mysql://user:password@localhost:3306/bjourneygo"
JWT_SECRET="replace_this_with_a_strong_secret"
PORT=4000
