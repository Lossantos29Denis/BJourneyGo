---
import Layout from '../layouts/Layout.astro';
import '../styles/checkout.css';
---

<Layout title="Pago cancelado — BJourneyGo">
  <main class="checkout-page">
    <section class="checkout-card">
      <h1>Pago cancelado</h1>
      <p>El pago no se completó. Puedes intentarlo de nuevo cuando quieras.</p>
      <div class="checkout-actions">
        <a href="/comprar" class="btn btn--primary">Volver a comprar</a>
        <a href="/" class="btn btn--ghost">Ir al inicio</a>
      </div>
    </section>
  </main>
</Layout>