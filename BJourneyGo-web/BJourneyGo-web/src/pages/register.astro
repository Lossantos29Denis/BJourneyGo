---
import AuthLayout from '../layouts/AuthLayout.astro';
import '../styles/register.css';
---

<AuthLayout title="Registrarse — BJourneyGo">
  <main class="container">
    <div class="site-header">
      <img src="/bJourneyGO4%20(1).png" alt="BJourneyGo logo" class="site-logo" />
      <div class="site-title">BJourneyGo</div>
    </div>

    <section class="login-card">
      <div class="login-header">
        <h1>Crear cuenta</h1>
        <p class="lead">Rellena los datos para crear una cuenta de ejemplo.</p>
      </div>

      <form id="registerForm" class="login-form" novalidate>
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" required placeholder="tu@correo.com" class="form-input" autocomplete="email" aria-label="Correo electrónico" aria-required="true" minlength="5" />

        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" required placeholder="contraseña" class="form-input" autocomplete="new-password" aria-label="Contraseña" aria-required="true" minlength="6" pattern=".{6,}" title="La contraseña debe tener al menos 6 caracteres" />

        <div class="btn-row">
          <button type="submit" class="btn btn--primary" style="width:100%">Crear cuenta</button>
        </div>
      </form>

      <div class="register-link">
        <p>¿Ya tienes cuenta? <a href="/login" class="link-register">Inicia sesión aquí</a></p>
      </div>

      <p class="notice">Te enviaremos un correo para confirmar la creacion de la cuenta.</p>
    </section>

    <div id="verifyModal" class="verify-modal" aria-hidden="true">
      <div class="verify-modal__backdrop"></div>
      <div class="verify-modal__card" role="dialog" aria-modal="true" aria-labelledby="verifyTitle">
        <div class="verify-modal__header">
          <h2 id="verifyTitle">Revisa tu correo</h2>
          <p>Te enviamos un enlace de verificación a <span id="verifyEmail" class="verify-email">tu correo</span>.</p>
        </div>
        <div class="verify-modal__body">
          <p>Abre tu Gmail, haz clic en el enlace y volveremos a esta ventana automáticamente.</p>
        </div>
        <div class="verify-modal__actions">
          <button type="button" id="openGmailBtn" class="btn btn--primary">Abrir Gmail</button>
          <button type="button" id="resendVerifyBtn" class="btn btn--ghost">Reenviar correo</button>
          <button type="button" id="checkVerificationBtn" class="btn btn--ghost">Ya he verificado</button>
        </div>
        <div id="verifyStatus" class="verify-modal__status" role="status" aria-live="polite"></div>
      </div>
    </div>
  </main>

  <script type="module" src="/src/scripts/register.js"></script>
</AuthLayout>
