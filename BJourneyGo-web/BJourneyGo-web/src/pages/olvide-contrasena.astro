---
import AuthLayout from '../layouts/AuthLayout.astro';
import '../styles/verify.css';
---

<AuthLayout title="Recuperar contraseña — BJourneyGo">
  <main class="container">
    <section class="verify-card" aria-live="polite">
      <h1>Recuperar contraseña</h1>
      <p class="verify-message" id="subtitle">Escribe tu correo y te enviaremos un enlace para restablecer tu contraseña.</p>

      <form id="forgotForm" novalidate style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1rem">
        <input
          id="email"
          name="email"
          type="email"
          placeholder="tu@correo.com"
          required
          autocomplete="email"
          style="border:1px solid rgba(255,255,255,0.15);border-radius:10px;padding:0.7rem 0.9rem;font-size:0.95rem;background:rgba(255,255,255,0.06);color:inherit;width:100%"
        />
        <button type="submit" class="btn btn--primary" id="submitBtn" style="width:100%">Enviar enlace</button>
      </form>

      <p id="statusMsg" style="display:none" class="verify-message"></p>

      <div class="verify-actions" style="margin-top:0.5rem">
        <a href="/login" class="btn btn--ghost">Volver al inicio de sesión</a>
      </div>
    </section>
  </main>

  <script type="module" src="/src/scripts/olvide-contrasena.js"></script>
</AuthLayout>
