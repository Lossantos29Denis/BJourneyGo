---
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';
---

<Layout title="BJourneyGo — Gestión de Rutas y Transportes">
  <div class="landing-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <div class="hero-text">
          <h1>Bienvenido a BJourneyGo</h1>
          <p class="hero-subtitle">Solución integral de gestión de rutas y transportes para tu negocio</p>
          <div class="hero-buttons">
            <a href="/login" class="btn btn-primary btn-large">Acceder a la Plataforma</a>
            <a href="#contact" class="btn btn-secondary btn-large">Contacta con Nosotros</a>
          </div>
        </div>
        <div class="hero-image">
          <svg viewBox="0 0 400 400" class="hero-svg">
            <title>Mapa ilustrado de optimización de rutas</title>
            <!-- Fondo degradado -->
            <defs>
              <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#f0f9ff;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#e8f4ff;stop-opacity:1" />
              </linearGradient>
              <linearGradient id="mapGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#FF6B35;stop-opacity:0.8" />
                <stop offset="100%" style="stop-color:#FF8A5B;stop-opacity:0.8" />
              </linearGradient>
            </defs>
            
            <rect width="400" height="400" fill="url(#bgGradient)"/>
            
            <!-- Círculo de fondo -->
            <circle cx="200" cy="200" r="140" fill="rgba(255, 107, 53, 0.1)"/>
            
            <!-- Mapa con rutas -->
            <g id="map">
              <!-- Ciudades (puntos) -->
              <circle cx="120" cy="140" r="8" fill="#FF6B35"/>
              <circle cx="280" cy="160" r="8" fill="#FF6B35"/>
              <circle cx="200" cy="260" r="8" fill="#FF6B35"/>
              <circle cx="150" cy="220" r="8" fill="#FF6B35"/>
              
              <!-- Rutas (líneas) -->
              <line x1="120" y1="140" x2="280" y2="160" stroke="url(#mapGradient)" stroke-width="4" stroke-linecap="round" opacity="0.7"/>
              <line x1="280" y1="160" x2="200" y2="260" stroke="url(#mapGradient)" stroke-width="4" stroke-linecap="round" opacity="0.7"/>
              <line x1="200" y1="260" x2="120" y2="140" stroke="url(#mapGradient)" stroke-width="4" stroke-linecap="round" opacity="0.7"/>
              <line x1="150" y1="220" x2="200" y2="260" stroke="url(#mapGradient)" stroke-width="4" stroke-linecap="round" opacity="0.7"/>
              
              <!-- Pequeños puntos de conexión -->
              <circle cx="120" cy="140" r="4" fill="white" opacity="0.8"/>
              <circle cx="280" cy="160" r="4" fill="white" opacity="0.8"/>
              <circle cx="200" cy="260" r="4" fill="white" opacity="0.8"/>
              <circle cx="150" cy="220" r="4" fill="white" opacity="0.8"/>
            </g>
            
            <!-- Vehículo animado (truck) -->
            <g id="truck" opacity="0.9">
              <rect x="240" y="165" width="30" height="20" rx="2" fill="#001F3F"/>
              <circle cx="250" cy="187" r="5" fill="#FF6B35"/>
              <circle cx="270" cy="187" r="5" fill="#FF6B35"/>
              <rect x="225" y="170" width="15" height="12" fill="#001F3F"/>
            </g>
            
            <!-- Texto decorativo -->
            <text x="200" y="340" font-size="14" text-anchor="middle" fill="#FF6B35" font-weight="600" opacity="0.7">
              Optimización de Rutas en Tiempo Real
            </text>
          </svg>
        </div>
      </div>
    </section>

    <!-- Características Principales -->
    <section class="features" id="features">
      <div class="container">
        <h2>¿Por Qué Elegir BJourneyGo?</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <h3>Optimización en Tiempo Real</h3>
            <p>Planifica y ajusta rutas instantáneamente con nuestro sistema inteligente de optimización.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                <path d="M8 12h8M12 8v8"/>
              </svg>
            </div>
            <h3>Panel de Control Intuitivo</h3>
            <p>Interfaz fácil de usar que permite a tu equipo trabajar más eficientemente desde el primer día.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            </div>
            <h3>Monitoreo Continuo</h3>
            <p>Sigue el estado de tus envíos en tiempo real y recibe notificaciones instantáneas.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v4"/>
              </svg>
            </div>
            <h3>Seguridad de Datos</h3>
            <p>Tus datos están protegidos con cifrado de nivel empresarial y cumplimiento GDPR.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            </div>
            <h3>Disponibilidad 24/7</h3>
            <p>Plataforma siempre disponible con soporte técnico a tu disposición en cualquier momento.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3"/>
                <polyline points="12 12 20 7.5"/>
                <polyline points="12 12 12 21"/>
                <polyline points="12 12 4 7.5"/>
              </svg>
            </div>
            <h3>Integración Fácil</h3>
            <p>Conecta con tus sistemas existentes sin complicaciones mediante nuestras APIs.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sobre Nosotros -->
    <section class="about" id="about">
      <div class="container">
        <div class="about-content">
          <div class="about-text">
            <h2>Sobre BJourneyGo</h2>
            <p>
              BJourneyGo es una plataforma especializada en la gestión integral de rutas y transportes, 
              diseñada para empresas que buscan optimizar sus operaciones logísticas.
            </p>
            <p>
              Nuestro equipo de expertos en logística y tecnología ha desarrollado una solución que 
              combina inteligencia artificial con interfaces intuitivas, permitiendo que negocios de 
              cualquier tamaño mejoren su eficiencia operacional.
            </p>
            <p>
              Desde pequeñas empresas de mensajería hasta grandes operadores logísticos, 
              BJourneyGo ayuda a empresas a:
            </p>
            <ul class="benefits-list">
              <li>Reducir costos de transporte hasta un 30%</li>
              <li>Mejorar la eficiencia de rutas en tiempo real</li>
              <li>Aumentar la satisfacción del cliente</li>
              <li>Optimizar la asignación de recursos</li>
              <li>Generar reportes detallados y análisis</li>
              <li>Escalar operaciones sin aumentar costos</li>
            </ul>
          </div>
          <div class="about-image">
            <svg viewBox="0 0 400 400" class="about-svg">
              <title>Indicadores de rendimiento de BJourneyGo</title>
              <defs>
                <linearGradient id="statsGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#FF6B35;stop-opacity:0.6" />
                  <stop offset="100%" style="stop-color:#FF8A5B;stop-opacity:0.6" />
                </linearGradient>
              </defs>
              
              <!-- Fondo -->
              <rect width="400" height="400" fill="#f0f9ff"/>
              
              <!-- Círculo decorativo -->
              <circle cx="200" cy="200" r="150" fill="none" stroke="#FF6B35" stroke-width="2" opacity="0.2"/>
              <circle cx="200" cy="200" r="130" fill="none" stroke="#FF6B35" stroke-width="1.5" opacity="0.15"/>
              
              <!-- Barra de progreso 1 -->
              <rect x="80" y="120" width="240" height="12" rx="6" fill="#e8f4ff"/>
              <rect x="80" y="120" width="180" height="12" rx="6" fill="url(#statsGradient)"/>
              <text x="330" y="130" font-size="12" fill="#FF6B35" font-weight="bold">75%</text>
              
              <!-- Barra de progreso 2 -->
              <rect x="80" y="165" width="240" height="12" rx="6" fill="#e8f4ff"/>
              <rect x="80" y="165" width="210" height="12" rx="6" fill="url(#statsGradient)"/>
              <text x="330" y="175" font-size="12" fill="#FF6B35" font-weight="bold">87%</text>
              
              <!-- Barra de progreso 3 -->
              <rect x="80" y="210" width="240" height="12" rx="6" fill="#e8f4ff"/>
              <rect x="80" y="210" width="200" height="12" rx="6" fill="url(#statsGradient)"/>
              <text x="330" y="220" font-size="12" fill="#FF6B35" font-weight="bold">83%</text>
              
              <!-- Etiquetas -->
              <text x="80" y="105" font-size="11" fill="#666" font-weight="600">Eficiencia Operativa</text>
              <text x="80" y="150" font-size="11" fill="#666" font-weight="600">Satisfacción Cliente</text>
              <text x="80" y="195" font-size="11" fill="#666" font-weight="600">Reducción Costos</text>
              
              <!-- Números destacados -->
              <g opacity="0.8">
                <circle cx="120" cy="290" r="30" fill="#FF6B35" opacity="0.1"/>
                <text x="120" y="300" font-size="18" text-anchor="middle" fill="#FF6B35" font-weight="bold">500+</text>
                <text x="120" y="318" font-size="9" text-anchor="middle" fill="#666" font-weight="600">Empresas</text>
                
                <circle cx="200" cy="290" r="30" fill="#FF6B35" opacity="0.1"/>
                <text x="200" y="300" font-size="18" text-anchor="middle" fill="#FF6B35" font-weight="bold">50K</text>
                <text x="200" y="318" font-size="9" text-anchor="middle" fill="#666" font-weight="600">Rutas/Mes</text>
                
                <circle cx="280" cy="290" r="30" fill="#FF6B35" opacity="0.1"/>
                <text x="280" y="300" font-size="18" text-anchor="middle" fill="#FF6B35" font-weight="bold">99.9%</text>
                <text x="280" y="318" font-size="9" text-anchor="middle" fill="#666" font-weight="600">Disponibilidad</text>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- Servicios -->
    <section class="services" id="services">
      <div class="container">
        <h2>Nuestros Servicios</h2>
        <div class="services-grid">
          <div class="service-item">
            <h3>Gestión de Rutas</h3>
            <p>Planificación inteligente de rutas con optimización automática basada en múltiples variables.</p>
          </div>
          <div class="service-item">
            <h3>Seguimiento en Tiempo Real</h3>
            <p>Monitoreo GPS continuo de todos tus vehículos y entregas con actualizaciones en vivo.</p>
          </div>
          <div class="service-item">
            <h3>Gestión de Flota</h3>
            <p>Control completo de tu flota con mantenimiento programado y análisis de desempeño.</p>
          </div>
          <div class="service-item">
            <h3>Reportes y Análisis</h3>
            <p>Dashboards personalizados con métricas clave y análisis detallados de operaciones.</p>
          </div>
          <div class="service-item">
            <h3>Facturación Automática</h3>
            <p>Sistema integrado de facturación que se sincroniza con tus operaciones automáticamente.</p>
          </div>
          <div class="service-item">
            <h3>Soporte y Capacitación</h3>
            <p>Equipo dedicado disponible 24/7 para ayudarte en cada paso del camino.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Estadísticas -->
    <section class="stats" id="stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-box">
            <div class="stat-number">500+</div>
            <div class="stat-label">Empresas Confiando en Nosotros</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">50,000+</div>
            <div class="stat-label">Rutas Optimizadas al Mes</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">99.9%</div>
            <div class="stat-label">Disponibilidad de Plataforma</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">15+</div>
            <div class="stat-label">Años de Experiencia</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <h2>¿Listo para Optimizar tus Operaciones?</h2>
        <p>Únete a cientos de empresas que ya están mejorando su eficiencia con BJourneyGo</p>
        <div class="cta-buttons">
          <a href="/login" class="btn btn-primary btn-large">Acceder Ahora</a>
          <a href="#contact" class="btn btn-secondary btn-large">Solicitar Demo</a>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section class="contact" id="contact">
      <div class="container">
        <h2>Contacta con Nosotros</h2>
        <div class="contact-content">
          <div class="contact-info">
            <div class="contact-item">
              <div class="contact-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <h3>Ubicación</h3>
                <p>Calle Principal 123, Barcelona, España</p>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div>
                <h3>Teléfono</h3>
                <p>+34 912 345 678</p>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="M7 9l5 4 5-4"/>
                </svg>
              </div>
              <div>
                <h3>Email</h3>
                <p>info@bjourney.com</p>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div>
                <h3>Horario</h3>
                <p>Lun - Vie: 9:00 - 18:00<br/>Sáb - Dom: Cerrado</p>
              </div>
            </div>
          </div>

          <form class="contact-form" id="contactForm">
            <div class="form-group">
              <label for="name">Nombre</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
              <label for="subject">Asunto</label>
              <input type="text" id="subject" name="subject" required>
            </div>
            <div class="form-group">
              <label for="message">Mensaje</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Enviar Mensaje</button>
          </form>
        </div>
      </div>
    </section>
  </div>

  <script type="module" src="/src/scripts/landing.js"></script>
</Layout>
