---
import Layout from '../layouts/Layout.astro';
import '../styles/configuracion.css';
---

<Layout title="Configuración — BJourneyGo">
  <div class="page-wrapper">
    <main class="container page-content">
      <section class="config-hero">
        <h1>Configuración de cuenta</h1>
        <p class="lead">Gestiona tu información personal y preferencias.</p>
      </section>

      <section class="config-panel">
        <h2>Información personal</h2>
        <form id="profileForm" class="config-form" novalidate>
          <div class="field">
            <label for="displayName">Nombre de usuario</label>
            <input id="displayName" name="displayName" type="text" placeholder="Tu nombre" class="form-input" required minlength="2" aria-label="Nombre de usuario" aria-required="true" />
          </div>

          <div class="field">
            <label for="email">Correo electrónico</label>
            <input id="email" name="email" type="email" placeholder="tu@correo.com" class="form-input" readonly aria-label="Correo electrónico" />
          </div>

          <div class="field">
            <label for="phone">Teléfono (opcional)</label>
            <div class="phone-row">
              <select id="phoneCountry" name="phoneCountry" class="form-select phone-prefix-select" aria-label="Prefijo del país">
                <option value="">🌐</option>
                <option value="ES" data-prefix="+34">🇪🇸 +34</option>
                <option value="US" data-prefix="+1">🇺🇸 +1</option>
                <option value="GB" data-prefix="+44">🇬🇧 +44</option>
                <option value="FR" data-prefix="+33">🇫🇷 +33</option>
                <option value="DE" data-prefix="+49">🇩🇪 +49</option>
                <option value="IT" data-prefix="+39">🇮🇹 +39</option>
                <option value="PT" data-prefix="+351">🇵🇹 +351</option>
                <option value="NL" data-prefix="+31">🇳🇱 +31</option>
                <option value="BE" data-prefix="+32">🇧🇪 +32</option>
                <option value="PL" data-prefix="+48">🇵🇱 +48</option>
              </select>
              <input id="phone" name="phone" type="tel" placeholder="+34 600 000 000" class="form-input phone-number-input" pattern="[\+0-9\s\-\(\)]{6,25}" aria-label="Número de teléfono completo" />
            </div>
          </div>

          <div class="btn-row">
            <button type="button" class="btn btn--ghost" onclick="history.back()">Cancelar</button>
            <button type="submit" class="btn btn--primary">Guardar cambios</button>
          </div>
        </form>
      </section>

      <section class="config-panel">
        <h2>Cambiar contraseña</h2>
        <form id="passwordForm" class="config-form" novalidate>
          <div class="field">
            <label for="currentPassword">Contraseña actual</label>
            <input id="currentPassword" name="currentPassword" type="password" placeholder="••••••••" class="form-input" required minlength="4" aria-label="Contraseña actual" aria-required="true" />
          </div>

          <div class="field">
            <label for="newPassword">Nueva contraseña</label>
            <input id="newPassword" name="newPassword" type="password" placeholder="••••••••" class="form-input" required minlength="6" aria-label="Nueva contraseña" aria-required="true" title="Mínimo 6 caracteres" />
          </div>

          <div class="field">
            <label for="confirmPassword">Confirmar contraseña</label>
            <input id="confirmPassword" name="confirmPassword" type="password" placeholder="••••••••" class="form-input" />
          </div>

          <div class="btn-row">
            <button type="submit" class="btn btn--primary">Cambiar contraseña</button>
          </div>
        </form>
      </section>

      <section class="config-panel danger">
        <h2>Zona de peligro</h2>
        <p class="text-muted">Acciones irreversibles en tu cuenta.</p>
        <button type="button" class="btn btn--ghost" id="deleteAccountBtn">Eliminar cuenta</button>
      </section>
    </main>
  </div>

  <script type="module" src="/src/scripts/configuracion.js"></script>
</Layout>
